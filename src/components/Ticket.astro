---
// Das nächste Spiel als Eintrittskarte mit Abriss
import { type Spiel, heimTeam, gastTeam, langesDatum, uhrzeit, heimspielort, liga, saison } from '../data/saison';

interface Props {
  spiel: Spiel;
}
const { spiel } = Astro.props;
const ort = spiel.heim ? heimspielort : `Sportplatz ${spiel.gegner}`;
---

<div class="ticket" role="group" aria-label={`Nächstes Spiel: ${heimTeam(spiel)} gegen ${gastTeam(spiel)}`}>
  <div class="ticket__haupt">
    <p class="ticket__kopf mono">
      <span>{spiel.heim ? 'Nächstes Heimspiel' : 'Nächstes Auswärtsspiel'}</span>
      <span>{spiel.spieltag}. Spieltag</span>
    </p>
    <p class="ticket__paarung">
      <span>{heimTeam(spiel)}</span>
      <span class="ticket__gegen" aria-hidden="true">gegen</span>
      <span class="visually-hidden">gegen</span>
      <span>{gastTeam(spiel)}</span>
    </p>
    <dl class="ticket__daten mono">
      <div>
        <dt>Anstoß</dt>
        <dd><time datetime={spiel.anstoss.toISOString()}>{langesDatum(spiel.anstoss)}, {uhrzeit(spiel.anstoss)}</time></dd>
      </div>
      <div>
        <dt>Ort</dt>
        <dd>{ort}</dd>
      </div>
      <div>
        <dt>Wettbewerb</dt>
        <dd>{liga}</dd>
      </div>
    </dl>
  </div>
  <div class="ticket__abriss" aria-hidden="true">
    <span class="ticket__preis">{spiel.heim ? '4 €' : 'Gäste'}</span>
    <span class="ticket__saison mono">Saison {saison}</span>
    <span class="ticket__code"></span>
  </div>
</div>

<style>
  .ticket {
    --kerbe: var(--rot);
    --ink-2: #36312a;
    --ink-3: #5c554b;
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    background: var(--kreide);
    color: var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
    transform: rotate(2deg);
    transition: transform 0.3s var(--ease);
  }
  .ticket:hover {
    transform: rotate(0.5deg);
  }
  .ticket__haupt {
    display: grid;
    gap: 1rem;
    padding: 1.25rem 1.75rem 1.4rem 1.4rem;
    border: 2px solid var(--ink);
    border-right: 0;
  }
  .ticket__kopf {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--ink);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .ticket__kopf span:first-child {
    color: var(--rot);
  }
  .ticket__paarung {
    display: grid;
    gap: 0.15rem;
    font-family: var(--font-display-stack);
    font-weight: 900;
    font-size: clamp(1.7rem, 1.3rem + 1.4vw, 2.5rem);
    line-height: 0.92;
    text-transform: uppercase;
  }
  .ticket__gegen {
    font-family: var(--font-mono-stack);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--rot);
    padding-block: 0.2rem;
  }
  .ticket__daten {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    font-size: 0.8rem;
  }
  .ticket__daten div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.5rem;
  }
  .ticket__daten dt {
    color: var(--ink-3);
    text-transform: uppercase;
  }
  .ticket__daten dd {
    margin: 0;
    font-weight: 700;
  }

  /* Abriss mit Perforation und halbrunden Kerben */
  .ticket__abriss {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: center;
    gap: 0.75rem;
    width: 5.5rem;
    padding: 1.25rem 0.6rem;
    background: var(--gelb);
    border: 2px solid var(--ink);
    border-left: 2px dashed var(--ink);
  }
  .ticket__abriss::before,
  .ticket__abriss::after {
    content: '';
    position: absolute;
    left: -0.85rem;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--kerbe);
    border: 2px solid var(--ink);
  }
  .ticket__abriss::before {
    top: -0.85rem;
  }
  .ticket__abriss::after {
    bottom: -0.85rem;
  }
  .ticket__preis {
    font-family: var(--font-display-stack);
    font-weight: 900;
    font-size: 2rem;
    line-height: 1;
  }
  .ticket__saison {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .ticket__code {
    width: 100%;
    height: 2.4rem;
    background: repeating-linear-gradient(90deg, var(--ink) 0 2px, transparent 2px 4px, var(--ink) 4px 5px, transparent 5px 8px, var(--ink) 8px 11px, transparent 11px 13px);
  }
  @media (max-width: 30rem) {
    .ticket {
      transform: none;
      grid-template-columns: 1fr;
    }
    .ticket__haupt {
      border-right: 2px solid var(--ink);
      border-bottom: 0;
    }
    .ticket__abriss {
      width: auto;
      grid-template-rows: none;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      padding: 0.8rem 1.4rem;
      border-left: 2px solid var(--ink);
      border-top: 2px dashed var(--ink);
    }
    .ticket__abriss::before,
    .ticket__abriss::after {
      display: none;
    }
    .ticket__saison {
      writing-mode: horizontal-tb;
      transform: none;
    }
    .ticket__code {
      width: 5rem;
    }
  }
</style>
