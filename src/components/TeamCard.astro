---
// Mannschaft als Sammelsticker
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  team: CollectionEntry<'mannschaften'>;
  ebene?: 'h2' | 'h3';
  eager?: boolean;
}
const { team, ebene = 'h3', eager = false } = Astro.props;
const { title, altersklasse, liga, image, imageAlt, order } = team.data;
const Ueberschrift = ebene;
---

<article class="sticker" data-bereich={team.data.bereich}>
  <div class="sticker__bild">
    <Picture
      src={image}
      alt={imageAlt}
      widths={[360, 480, 560, 720, 800]}
      sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 46vw, 92vw"
      formats={['avif', 'webp']}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
    <span class="sticker__nr mono" aria-hidden="true">{String(order).padStart(2, '0')}</span>
    <span class="sticker__bereich mono">{team.data.bereich}</span>
  </div>
  <div class="sticker__text">
    <Ueberschrift class="sticker__titel">
      <a href={`/mannschaften/${team.id}/`}>{title}</a>
    </Ueberschrift>
    <p class="sticker__meta mono">{altersklasse} · {liga}</p>
  </div>
</article>

<style>
  .sticker {
    position: relative;
    display: grid;
    padding: 0.55rem;
    background: #fff;
    color: var(--ink);
    border-radius: 0.9rem;
    box-shadow:
      0 1px 0 rgb(0 0 0 / 0.08),
      0 14px 24px -14px rgb(0 0 0 / 0.45);
    transform: rotate(var(--dreh, -1.2deg));
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }
  .sticker:nth-child(3n + 2) {
    --dreh: 1.1deg;
  }
  .sticker:nth-child(3n) {
    --dreh: -0.4deg;
  }
  .sticker:hover {
    transform: rotate(0deg) translateY(-4px);
    box-shadow:
      0 1px 0 rgb(0 0 0 / 0.08),
      0 22px 30px -14px rgb(0 0 0 / 0.5);
  }
  .sticker__bild {
    position: relative;
    aspect-ratio: 4 / 3.4;
    overflow: hidden;
    border-radius: 0.5rem 0.5rem 0 0;
    background: var(--rot);
  }
  .sticker__bild :global(picture),
  .sticker__bild :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sticker__bild :global(img) {
    transition: transform 0.8s var(--ease);
  }
  .sticker:hover .sticker__bild :global(img) {
    transform: scale(1.04);
  }
  .sticker__nr {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--gelb);
    border: 2px solid var(--ink);
    font-size: 0.95rem;
    font-weight: 700;
  }
  .sticker__bereich {
    position: absolute;
    top: 0.8rem;
    right: 0;
    padding: 0.25rem 0.6rem 0.2rem;
    background: var(--ink);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .sticker__text {
    display: grid;
    gap: 0.35rem;
    padding: 0.85rem 0.9rem 0.8rem;
    background: var(--rot);
    color: #fff;
    border-radius: 0 0 0.5rem 0.5rem;
  }
  /* Schrägschnitt wie das Namensband auf Sammelbildern */
  .sticker__bild::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 0.8rem;
    background: var(--rot);
    clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }
  .sticker__titel {
    font-size: var(--step-2);
    line-height: 0.9;
  }
  .sticker__titel a {
    text-decoration: none;
  }
  .sticker__titel a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .sticker__titel a:focus-visible {
    outline: none;
  }
  .sticker:has(a:focus-visible) {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
  }
  .sticker__meta {
    font-size: 0.72rem;
    text-transform: uppercase;
    color: #f6ddd8;
  }
</style>
