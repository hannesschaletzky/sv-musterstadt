---
import { ersteller, stile } from '../data/verein';
---

<aside class="demobar mono" aria-label="Hinweis zum Beispielprojekt">
  <div class="container demobar__inner">
    <p>
      Beispielprojekt: Der Verein ist erfunden. Website von <a href={ersteller.url}>{ersteller.name}</a>
    </p>
    <nav class="stilwahl" aria-label="Designvariante">
      <span>Design:</span>
      <ul>
        {
          stile
            .filter((s) => s.imSchalter)
            .map((s) => (
              <li>
                <a href={`?stil=${s.id}`} data-stil-link={s.id}>
                  {s.label}
                </a>
              </li>
            ))
        }
      </ul>
      <div class="stilhinweis" id="stilhinweis" hidden>
        <p><strong>Drei Designs, ein Inhalt.</strong> Diese Beispielseite gibt es in drei Stilen. Probier es hier oben aus.</p>
        <button type="button" class="stilhinweis__zu" aria-label="Hinweis schließen">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
        </button>
      </div>
    </nav>
  </div>
</aside>

<script>
  const wurzel = document.documentElement;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-stil-link]')];
  const wahl = document.querySelector<HTMLElement>('.stilwahl');
  const hinweis = document.querySelector<HTMLElement>('#stilhinweis');
  const ruhig = matchMedia('(prefers-reduced-motion: reduce)');

  // localStorage kann gesperrt sein (privates Fenster), dann gibt es eben kein Gedächtnis
  const lesen = (schluessel: string) => {
    try {
      return localStorage.getItem(schluessel);
    } catch {
      return null;
    }
  };
  const merken = (schluessel: string, wert: string) => {
    try {
      localStorage.setItem(schluessel, wert);
    } catch {}
  };

  // Hinweis beim ersten Besuch: kurz nach dem Laden einblenden, danach nie wieder
  const hinweisWeg = () => {
    if (!hinweis || hinweis.hidden) return;
    hinweis.hidden = true;
    wahl?.classList.remove('lockt');
    merken('stilhinweis', 'gesehen');
  };
  if (hinweis && !lesen('stilhinweis')) {
    setTimeout(() => {
      hinweis.hidden = false;
      wahl?.classList.add('lockt');
    }, 1200);
  }
  hinweis?.querySelector('button')?.addEventListener('click', hinweisWeg);

  const setzen = (stil: string) => {
    wurzel.dataset.stil = stil;
    merken('stil', stil);
    links.forEach((a) => (a.dataset.stilLink === stil ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    const url = new URL(location.href);
    url.searchParams.set('stil', stil);
    history.replaceState(history.state, '', url);
  };

  // Umschalten ohne Neuladen: das neue Design wächst als Kreis aus dem angeklickten Knopf
  links.forEach((a) =>
    a.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      hinweisWeg();
      const stil = a.dataset.stilLink;
      if (!stil || stil === wurzel.dataset.stil) return;
      if (!document.startViewTransition || ruhig.matches) {
        setzen(stil);
        return;
      }

      const r = a.getBoundingClientRect();
      const x = r.left + r.width / 2;
      const y = r.top + r.height / 2;
      const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

      wurzel.classList.add('stilwechsel');
      const wechsel = document.startViewTransition(async () => {
        setzen(stil);
        // Schriften des neuen Stils kurz abwarten, damit der Kreis nicht die Ersatzschrift zeigt
        void document.body.offsetHeight;
        await Promise.race([document.fonts.ready, new Promise((fertig) => setTimeout(fertig, 400))]);
      });
      wechsel.ready.then(() =>
        wurzel.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
          { duration: 750, easing: 'cubic-bezier(0.65, 0, 0.35, 1)', pseudoElement: '::view-transition-new(root)' },
        ),
      );
      wechsel.finished.finally(() => wurzel.classList.remove('stilwechsel'));
    }),
  );
</script>

<style>
  .demobar {
    --demobar-bg: var(--gelb);
    --demobar-fg: var(--ink);
    position: relative;
    z-index: 60;
    background: var(--demobar-bg);
    color: var(--demobar-fg);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .demobar__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.25rem 1.5rem;
    padding-block: 0.4rem;
  }
  a {
    font-weight: 700;
  }
  .stilwahl {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  ul {
    display: flex;
    gap: 0.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stilwahl a {
    display: block;
    padding: 0.2rem 0.5rem 0.15rem;
    border: 1px solid currentColor;
    text-decoration: none;
    opacity: 0.7;
  }
  .stilwahl a:hover {
    opacity: 1;
  }
  /* Aktiver Stil: invertiert */
  :global(:root[data-stil='schlicht']) [data-stil-link='schlicht'],
  :global(:root[data-stil='flutlicht']) [data-stil-link='flutlicht'],
  :global(:root[data-stil='plakat']) [data-stil-link='plakat'] {
    opacity: 1;
    background: var(--demobar-fg);
    color: var(--demobar-bg);
  }
  /* Solange der Hinweis steht, pulsieren die anderen Stile dreimal */
  .stilwahl.lockt a:not([aria-current]) {
    animation: locken 1.6s var(--ease) 3;
  }
  .stilwahl.lockt li:nth-child(3) a {
    animation-delay: 0.2s;
  }
  @keyframes locken {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--demobar-fg) 60%, transparent);
      opacity: 1;
    }
    70%,
    100% {
      box-shadow: 0 0 0 0.5rem transparent;
    }
  }

  /* Sprechblase unter dem Schalter, Spitze nach oben. Farben, Ecken und Schatten kommen aus dem jeweiligen Stil. */
  .stilhinweis {
    --hinweis-bg: var(--kreide);
    --hinweis-fg: var(--ink);
    --hinweis-rand: var(--ink);
    position: absolute;
    top: calc(100% + 0.9rem);
    right: 0;
    width: min(19rem, calc(100vw - 2 * var(--gutter)));
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: start;
    padding: 0.9rem 0.9rem 0.95rem 1.1rem;
    background: var(--hinweis-bg);
    color: var(--hinweis-fg);
    border: 1px solid var(--hinweis-rand);
    border-radius: var(--radius);
    box-shadow:
      0.3rem 0.3rem 0 var(--schatten),
      0 1.25rem 2.5rem -1.25rem rgb(0 0 0 / 0.35);
    font-family: var(--font-body-stack);
    font-size: 0.9rem;
    letter-spacing: 0;
    line-height: 1.45;
    text-transform: none;
    animation: hinweis-rein 0.45s var(--ease) both;
  }
  .stilhinweis[hidden] {
    display: none;
  }
  .stilhinweis::before {
    content: '';
    position: absolute;
    top: -0.45rem;
    right: 4.5rem;
    width: 0.8rem;
    height: 0.8rem;
    background: var(--hinweis-bg);
    border-top: 1px solid var(--hinweis-rand);
    border-left: 1px solid var(--hinweis-rand);
    rotate: 45deg;
  }
  .stilhinweis strong {
    display: block;
    margin-bottom: 0.15rem;
  }
  .stilhinweis__zu {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0.35rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--kreide);
    cursor: pointer;
  }
  .stilhinweis__zu svg {
    width: 100%;
    height: 100%;
  }
  @keyframes hinweis-rein {
    from {
      opacity: 0;
      transform: translateY(-0.4rem);
    }
  }
  /* Schmal steht der Schalter links unter dem Hinweistext */
  @media (max-width: 40rem) {
    .stilhinweis {
      right: auto;
      left: 0;
    }
    .stilhinweis::before {
      right: auto;
      left: 6rem;
    }
  }
</style>
