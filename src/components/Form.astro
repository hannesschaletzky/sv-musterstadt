---
// Formkurve: die letzten Ergebnisse als S/U/N-Kästchen
import type { Ausgang } from '../data/saison';

interface Props {
  form: Ausgang[];
}
const { form } = Astro.props;
const lang = { S: 'Sieg', U: 'Unentschieden', N: 'Niederlage' };
---

<ol class="form" aria-label={`Die letzten ${form.length} Spiele, ältestes zuerst`}>
  {
    form.map((a) => (
      <li class:list={['form__spiel', `form__spiel--${a}`]}>
        <abbr title={lang[a]}>{a}</abbr>
      </li>
    ))
  }
</ol>

<style>
  .form {
    display: flex;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .form__spiel {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 2px solid var(--ink);
    font-family: var(--font-mono-stack);
    font-weight: 700;
    font-size: 0.9rem;
    color: #fff;
  }
  abbr {
    text-decoration: none;
  }
  .form__spiel--S {
    background: var(--rasen);
  }
  .form__spiel--U {
    background: var(--kreide);
    color: var(--ink);
  }
  .form__spiel--N {
    background: var(--rot-2);
  }
</style>
