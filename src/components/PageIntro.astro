---
// Seitenkopf auf Papier mit Rasterpunkten und gezacktem Abrissrand
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="intro getoent streifen">
  <div class="container intro__inner">
    <span class="eyebrow">{eyebrow}</span>
    <h1 class="display" set:html={title} />
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .intro {
    position: relative;
    margin-bottom: 14px;
  }
  .intro::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 14px;
    background: conic-gradient(from -45deg at bottom, var(--kreide-2) 90deg, transparent 0) 0 0 / 28px 100%;
  }
  .intro__inner {
    padding-top: clamp(3rem, 2rem + 5vw, 6rem);
    padding-bottom: clamp(3rem, 2rem + 4vw, 5rem);
    display: grid;
    gap: 1.5rem;
  }
  h1 {
    max-width: 15ch;
  }
  h1 :global(em) {
    font-style: normal;
    color: var(--rot);
  }
</style>
