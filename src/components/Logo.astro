---
import Wappen from './Wappen.astro';
---

<span class="logo">
  <span class="logo__wappen"><Wappen /></span>
  <span class="logo__text">
    <span class="logo__name">SV Musterstadt</span>
    <span class="logo__jahr">Seit 1921 · Rot-Weiß</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    line-height: 1;
  }
  .logo__wappen {
    display: block;
    height: 2.75rem;
    flex: none;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .logo__name {
    font-family: var(--font-display-stack);
    font-weight: 800;
    font-size: 1.45rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .logo__jahr {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.75;
  }
</style>
