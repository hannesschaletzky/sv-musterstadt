---
import Logo from './Logo.astro';
import { navigation } from '../data/verein';
import { naechstesSpiel, heimTeam, gastTeam, wochentag, tagMonat, uhrzeit, eigeneZeile } from '../data/saison';

const pfad = Astro.url.pathname;
const aktiv = (href: string) => pfad.startsWith(href);
const nr = (i: number) => String(i + 1).padStart(2, '0');
const s = naechstesSpiel;
---

<div class="ticker nacht mono">
  <div class="container ticker__inner">
    <a href="/spielplan/" class="ticker__spiel">
      <span class="ticker__punkt" aria-hidden="true"></span>
      <span class="ticker__label">Nächstes Spiel</span>
      <time datetime={s.anstoss.toISOString()}>{wochentag(s.anstoss)} {tagMonat(s.anstoss)} · {uhrzeit(s.anstoss)}</time>
      <span class="ticker__paarung">{heimTeam(s)} – {gastTeam(s)}</span>
    </a>
    <span class="ticker__stand">Tabelle: Platz {eigeneZeile.platz} · {eigeneZeile.punkte} Pkt.</span>
  </div>
</div>

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__logo">
      <Logo />
      <span class="visually-hidden">, zur Startseite</span>
    </a>

    <nav aria-label="Hauptnavigation" class="header__nav">
      <ul>
        {
          navigation.map((item, i) => (
            <li>
              <a href={item.href} aria-current={aktiv(item.href) ? 'page' : undefined}>
                <span class="header__nr" aria-hidden="true">{nr(i)}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/mitmachen/" class="header__cta" aria-current={aktiv('/mitmachen/') ? 'page' : undefined}>Mitmachen</a>

    <button class="header__toggle" popovertarget="menu" aria-label="Menü öffnen">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div id="menu" popover class="menu rot">
    <div class="menu__head container">
      <Logo />
      <button popovertarget="menu" popovertargetaction="hide" class="menu__close" aria-label="Menü schließen">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2.5"></path></svg>
      </button>
    </div>
    <nav aria-label="Mobile Navigation" class="container">
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a href={item.href} aria-current={aktiv(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li><a href="/mitmachen/" aria-current={aktiv('/mitmachen/') ? 'page' : undefined}>Mitmachen</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .ticker {
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .ticker__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 2.25rem;
  }
  .ticker__spiel {
    display: flex;
    align-items: center;
    gap: 0.4rem 0.9rem;
    min-width: 0;
    text-decoration: none;
    color: var(--gelb);
  }
  .ticker__spiel:hover .ticker__paarung {
    text-decoration: underline;
  }
  .ticker__punkt {
    width: 0.5rem;
    height: 0.5rem;
    flex: none;
    border-radius: 50%;
    background: var(--rot);
    box-shadow: 0 0 0 3px rgb(179 38 30 / 0.35);
  }
  .ticker__spiel time {
    white-space: nowrap;
  }
  .ticker__label {
    color: var(--on-nacht-2);
  }
  .ticker__paarung {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--on-nacht);
  }
  .ticker__stand {
    flex: none;
    color: var(--on-nacht-2);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ticker__punkt {
      animation: blinken 1.6s steps(2, jump-none) infinite;
    }
  }
  @keyframes blinken {
    50% {
      opacity: 0.25;
    }
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--kreide);
    border-bottom: 3px solid var(--ink);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 4.75rem;
  }
  .header__logo {
    text-decoration: none;
    margin-right: auto;
  }
  .header__nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .header__nav a {
    display: flex;
    align-items: start;
    gap: 0.3rem;
    padding: 0.45rem 0.7rem 0.35rem;
    text-decoration: none;
    font-family: var(--font-display-stack);
    font-size: 1.35rem;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    transition:
      background-color 0.15s var(--ease),
      color 0.15s var(--ease);
  }
  .header__nr {
    font-family: var(--font-mono-stack);
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--rot);
  }
  .header__nav a:hover {
    background: var(--ink);
    color: var(--kreide);
  }
  .header__nav a[aria-current='page'] {
    background: var(--rot);
    color: #fff;
  }
  .header__nav a:hover .header__nr,
  .header__nav a[aria-current='page'] .header__nr {
    color: var(--gelb);
  }

  /* Aufkleber statt Button */
  .header__cta {
    display: grid;
    place-items: center;
    padding: 0.7rem 1.1rem 0.6rem;
    background: var(--gelb);
    border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    font-family: var(--font-display-stack);
    font-weight: 900;
    font-size: 1.3rem;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    transform: rotate(-3deg);
    transition: transform 0.2s var(--ease);
  }
  .header__cta:hover {
    transform: rotate(0deg) scale(1.05);
  }

  .header__toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 2px solid var(--ink);
    background: var(--gelb);
    box-shadow: 3px 3px 0 var(--ink);
    color: inherit;
    cursor: pointer;
    position: relative;
  }
  .header__toggle span {
    position: absolute;
    left: 0.55rem;
    right: 0.55rem;
    height: 3px;
    background: currentColor;
  }
  .header__toggle span:nth-child(1) {
    top: 0.7rem;
  }
  .header__toggle span:nth-child(2) {
    top: 1.15rem;
    right: 1rem;
  }
  .header__toggle span:nth-child(3) {
    top: 1.6rem;
  }

  .menu {
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    border: 0;
    padding: 0;
    opacity: 0;
    transition:
      opacity 0.25s var(--ease),
      display 0.25s allow-discrete,
      overlay 0.25s allow-discrete;
  }
  .menu:popover-open {
    opacity: 1;
  }
  @starting-style {
    .menu:popover-open {
      opacity: 0;
    }
  }
  .menu__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.75rem;
  }
  .menu__close {
    width: 2.75rem;
    height: 2.75rem;
    border: 2px solid currentColor;
    background: none;
    color: inherit;
    cursor: pointer;
    padding: 0.45rem;
  }
  .menu ul {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    counter-reset: menu;
  }
  .menu li {
    border-top: 2px solid rgb(255 255 255 / 0.4);
    counter-increment: menu;
  }
  .menu li a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.7rem 0.5rem;
    font-family: var(--font-display-stack);
    font-weight: 900;
    font-size: clamp(2.6rem, 12vw, 4rem);
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
  }
  .menu li a::before {
    content: counter(menu, decimal-leading-zero);
    font-family: var(--font-mono-stack);
    font-size: 0.9rem;
    font-weight: 700;
  }
  .menu li a[aria-current='page'] {
    color: var(--gelb);
  }

  @media (max-width: 70rem) {
    .header__nav,
    .header__cta {
      display: none;
    }
    .header__toggle {
      display: block;
    }
  }
  @media (max-width: 46rem) {
    .ticker__stand,
    .ticker__spiel time {
    white-space: nowrap;
  }
  .ticker__label {
      display: none;
    }
  }
</style>
