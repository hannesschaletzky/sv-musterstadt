---
import Logo from './Logo.astro';
import { navigation } from '../data/verein';

const pfad = Astro.url.pathname;
const aktiv = (href: string) => pfad.startsWith(href);
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__logo">
      <Logo />
      <span class="visually-hidden">, zur Startseite</span>
    </a>

    <nav aria-label="Hauptnavigation" class="header__nav">
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a href={item.href} aria-current={aktiv(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/mitmachen/" class="btn btn--rot header__cta">Mitmachen</a>

    <button class="header__toggle" popovertarget="menu" aria-label="Menü öffnen">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div id="menu" popover class="menu nacht streifen">
    <div class="menu__head container">
      <Logo />
      <button popovertarget="menu" popovertargetaction="hide" class="menu__close" aria-label="Menü schließen">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2"></path></svg>
      </button>
    </div>
    <nav aria-label="Mobile Navigation" class="container">
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a href={item.href} aria-current={aktiv(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li><a href="/mitmachen/" aria-current={aktiv('/mitmachen/') ? 'page' : undefined}>Mitmachen</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--kreide) 90%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    border-bottom: 3px solid var(--rot);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 4.75rem;
  }
  .header__logo {
    text-decoration: none;
    margin-right: auto;
  }
  .header__nav ul {
    display: flex;
    gap: 1.9rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .header__nav a {
    position: relative;
    display: block;
    text-decoration: none;
    font-family: var(--font-display-stack);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding-block: 0.5rem;
  }
  .header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.15rem;
    height: 3px;
    background: var(--rot);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }
  .header__nav a:hover::after,
  .header__nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .header__toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    position: relative;
  }
  .header__toggle span {
    position: absolute;
    left: 0.55rem;
    right: 0.55rem;
    height: 2px;
    background: currentColor;
  }
  .header__toggle span:nth-child(1) {
    top: 0.85rem;
  }
  .header__toggle span:nth-child(2) {
    top: 1.33rem;
    right: 1rem;
  }
  .header__toggle span:nth-child(3) {
    top: 1.81rem;
  }

  .menu {
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    border: 0;
    padding: 0;
    opacity: 0;
    transition:
      opacity 0.25s var(--ease),
      display 0.25s allow-discrete,
      overlay 0.25s allow-discrete;
  }
  .menu:popover-open {
    opacity: 1;
  }
  @starting-style {
    .menu:popover-open {
      opacity: 0;
    }
  }
  .menu__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.75rem;
  }
  .menu__close {
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    padding: 0.5rem;
  }
  .menu ul {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    counter-reset: menu;
  }
  .menu li {
    border-bottom: 1px solid var(--nacht-line);
    counter-increment: menu;
  }
  .menu li a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.9rem;
    font-family: var(--font-display-stack);
    font-weight: 800;
    font-size: 2.6rem;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
  }
  .menu li a::before {
    content: counter(menu, decimal-leading-zero);
    font-size: 1rem;
    font-weight: 600;
    color: var(--on-nacht-2);
  }
  .menu li a[aria-current='page'] {
    color: var(--rot-hell);
  }

  @media (max-width: 64rem) {
    .header__nav,
    .header__cta {
      display: none;
    }
    .header__toggle {
      display: block;
    }
  }
</style>
