---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { datum } from '../data/verein';

interface Props {
  beitrag: CollectionEntry<'aktuelles'>;
  gross?: boolean;
  ebene?: 'h2' | 'h3';
  eager?: boolean;
}
const { beitrag, gross = false, ebene = 'h3', eager = false } = Astro.props;
const { title, description, date, rubrik, image, imageAlt } = beitrag.data;
const Ueberschrift = ebene;
---

<article class:list={['news', { 'news--gross': gross }]}>
  <div class="img-frame hover-zoom news__bild">
    <Picture
      src={image}
      alt={imageAlt}
      widths={gross ? [400, 560, 720, 1100, 1600] : [360, 480, 560, 720, 800]}
      sizes={gross ? '(min-width: 64rem) 58vw, 92vw' : '(min-width: 64rem) 30vw, (min-width: 40rem) 46vw, 92vw'}
      formats={['avif', 'webp']}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
    <span class="news__rubrik mono">{rubrik}</span>
  </div>
  <div class="news__text">
    <p class="news__meta mono">
      <time datetime={date.toISOString().slice(0, 10)}>{datum(date)}</time>
    </p>
    <Ueberschrift class="news__titel">
      <a href={`/aktuelles/${beitrag.id}/`}>{title}</a>
    </Ueberschrift>
    <p class="news__teaser">{description}</p>
  </div>
</article>

<style>
  .news {
    position: relative;
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .news__bild {
    position: relative;
    aspect-ratio: 3 / 2;
    border: 2px solid var(--ink);
  }
  .news__rubrik {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.3rem 0.55rem 0.25rem;
    background: var(--gelb);
    color: var(--ink);
    border: 2px solid var(--ink);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transform: rotate(-2deg);
  }
  .news__text {
    display: grid;
    gap: 0.6rem;
  }
  .news__meta {
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .news__titel {
    font-size: var(--step-2);
    line-height: 0.92;
  }
  .news__titel a {
    text-decoration: none;
  }
  .news__titel a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .news:hover .news__titel a,
  .news__titel a:focus-visible {
    background: linear-gradient(var(--gelb), var(--gelb)) 0 88% / 100% 0.35em no-repeat;
  }
  .news__teaser {
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .news:not(.news--gross) .news__teaser {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .news--gross .news__titel {
    font-size: var(--step-4);
    line-height: 0.86;
  }
  .news--gross .news__teaser {
    font-size: var(--step-1);
    line-height: 1.45;
  }
  @media (min-width: 64rem) {
    .news--gross .news__bild {
      aspect-ratio: 16 / 10;
    }
  }
</style>
