---
// Anzeigetafel für ein Spiel: Paarung, Ergebnis oder Anstoßzeit, Datum und Ort
import Badge from './Badge.astro';
import { type Spiel, heimTeam, gastTeam, tore, langesDatum, uhrzeit, heimspielort, liga, ausgang } from '../data/saison';

interface Props {
  spiel: Spiel;
  label: string;
}
const { spiel, label } = Astro.props;
const ergebnis = tore(spiel);
const ort = spiel.heim ? heimspielort : `Auswärts bei ${spiel.gegner}`;
const ausgangText = spiel.ergebnis && { S: 'Sieg', U: 'Unentschieden', N: 'Niederlage' }[ausgang(spiel.ergebnis)];
---

<div class="karte" role="group" aria-label={`${label}: ${heimTeam(spiel)} gegen ${gastTeam(spiel)}`}>
  <header class="karte__kopf">
    <span>{label}</span>
    <span>{spiel.spieltag}. Spieltag</span>
  </header>

  <div class="karte__paarung">
    <div class="karte__team">
      <Badge verein={heimTeam(spiel)} />
      <span>{heimTeam(spiel)}</span>
    </div>
    {
      ergebnis ? (
        <p class="karte__stand zahlen">
          <span class="visually-hidden">{`Endstand ${ergebnis[0]} zu ${ergebnis[1]}, ${ausgangText} für den SV Musterstadt`}</span>
          <span aria-hidden="true">
            {ergebnis[0]}
            <span class="karte__doppelpunkt">:</span>
            {ergebnis[1]}
          </span>
        </p>
      ) : (
        <p class="karte__stand karte__stand--zeit zahlen">
          <span class="visually-hidden">Anstoß um</span>
          <time datetime={spiel.anstoss.toISOString()}>{uhrzeit(spiel.anstoss)}</time>
        </p>
      )
    }
    <div class="karte__team">
      <Badge verein={gastTeam(spiel)} />
      <span>{gastTeam(spiel)}</span>
    </div>
  </div>

  <footer class="karte__fuss">
    <time datetime={spiel.anstoss.toISOString()}>{langesDatum(spiel.anstoss)}, {uhrzeit(spiel.anstoss)} Uhr</time>
    <span>{ort}</span>
    <span>{liga}</span>
  </footer>
</div>

<style>
  .karte {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    background: var(--nacht);
    color: var(--on-nacht);
    border-radius: var(--radius);
    border-top: 5px solid var(--rot);
    --badge: clamp(3rem, 2.4rem + 2vw, 4.25rem);
  }
  .karte__kopf,
  .karte__fuss {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1.25rem;
    font-size: 0.85rem;
    color: var(--on-nacht-2);
  }
  .karte__kopf {
    font-family: var(--font-display-stack);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .karte__kopf span:first-child {
    color: var(--rot-hell);
  }
  .karte__paarung {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }
  .karte__team {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    text-align: center;
    font-family: var(--font-display-stack);
    font-weight: 600;
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.3rem);
    line-height: 1.05;
    text-transform: uppercase;
  }
  .karte__stand {
    font-family: var(--font-display-stack);
    font-weight: 800;
    font-size: clamp(2.6rem, 2rem + 3vw, 4.5rem);
    line-height: 1;
    padding: 0.4rem 0.9rem 0.2rem;
    background: var(--nacht-2);
    border-radius: var(--radius);
    white-space: nowrap;
  }
  .karte__stand--zeit {
    font-size: clamp(2rem, 1.6rem + 2vw, 3.3rem);
  }
  .karte__doppelpunkt {
    color: var(--rot-hell);
    padding-inline: 0.1em;
  }
  .karte__fuss {
    padding-top: 1.1rem;
    border-top: 1px solid var(--nacht-line);
  }
</style>
