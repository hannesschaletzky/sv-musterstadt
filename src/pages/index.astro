---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import Ticket from '../components/Ticket.astro';
import Fanschal from '../components/Fanschal.astro';
import Spielkarte from '../components/Spielkarte.astro';
import Tabelle from '../components/Tabelle.astro';
import Form from '../components/Form.astro';
import NewsCard from '../components/NewsCard.astro';
import TeamCard from '../components/TeamCard.astro';
import Wortmarke from '../components/Wortmarke.astro';
import MitmachenCta from '../components/MitmachenCta.astro';
import { verein, datum } from '../data/verein';
import { naechstesSpiel, letztesSpiel, form, eigeneZeile, liga, saison } from '../data/saison';
import { hauptsponsor, premium } from '../data/sponsoren';

import heroBild from '../assets/images/hero-flutlicht.jpg';
import heimspielBild from '../assets/images/heimspiel.jpg';

const news = (await getCollection('aktuelles')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const startTeams = ['erste-herren', 'frauen', 'a-junioren', 'b-juniorinnen', 'f-junioren', 'bambini'];
const alleTeams = await getCollection('mannschaften');
const teams = alleTeams.filter((t) => startTeams.includes(t.id)).sort((a, b) => a.data.order - b.data.order);

const zahlen = [
  { wert: String(verein.gruendung), label: 'gegründet' },
  { wert: String(verein.mitglieder), label: 'Mitglieder' },
  { wert: String(alleTeams.length), label: 'Mannschaften' },
  { wert: String(verein.ehrenamtliche), label: 'Ehrenamtliche' },
];
---

<BaseLayout
  title="Startseite"
  description="SV Musterstadt 1921: Fußball für alle in Musterstadt. Spielplan, Tabelle, Mannschaften und Trainingszeiten, Probetraining jederzeit."
>
  <section class="hero rot" aria-labelledby="hero-titel">
    <div class="container hero__inner">
      <p class="hero__masthead mono">
        <span>{verein.kurzname}</span>
        <span>Saison {saison}</span>
        <span class="hero__masthead-ort">{verein.sportpark}</span>
      </p>

      <h1 id="hero-titel" class="hero__titel">
        <span class="hero__zeile">
          Hier{' '}
          <span class="hero__foto">
            <Picture
              src={heroBild}
              alt=""
              widths={[320, 480, 720, 960, 1200]}
              sizes="(min-width: 60rem) 45vw, 60vw"
              formats={['avif', 'webp']}
              loading="eager"
              fetchpriority="high"
            />
          </span>{' '}
          spielt
        </span>
        <span class="hero__zeile hero__zeile--gross">Musterstadt.</span>
      </h1>

      <div class="hero__unten">
        <a href="/mitmachen/" class="hero__stempel" aria-label="Probetraining: kostenlos und jederzeit">
          <svg viewBox="0 0 120 120" aria-hidden="true">
            <defs><path id="stempel-kreis" d="M60 60m-46 0a46 46 0 1 1 92 0a46 46 0 1 1-92 0"></path></defs>
            <text><textPath href="#stempel-kreis">Probetraining · kostenlos · jederzeit ·</textPath></text>
          </svg>
          <span aria-hidden="true">★</span>
        </a>

        <div class="hero__text">
          <p class="lead">
            Neun Mannschaften, von den Bambini bis zu den Alten Herren. Ein Platz am Mühlbach, ein Vereinsheim mit der besten Bratwurst im
            Kreis und Platz für alle, die mitspielen wollen.
          </p>
          <div class="hero__aktionen">
            <a href="/mitmachen/" class="btn btn--gelb">Probetraining <Arrow /></a>
            <a href="/spielplan/" class="btn btn--rand">Spielplan &amp; Tabelle</a>
          </div>
          <dl class="hero__zahlen" aria-label="Der Verein in Zahlen">
            {
              zahlen.map((z) => (
                <div>
                  <dt class="mono">{z.label}</dt>
                  <dd>{z.wert}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <!-- Nur im Stil „Schlicht“ sichtbar. Gleiche Bildgrößen wie im Titel, damit der Browser dieselbe Datei nimmt. -->
        <div class="hero__bild img-frame">
          <Picture
            src={heroBild}
            alt="Eckfahne an einem Fußballplatz am Abend, im Hintergrund leuchtet das Flutlicht durch den Nebel"
            widths={[320, 480, 720, 960, 1200]}
            sizes="(min-width: 60rem) 45vw, 60vw"
            formats={['avif', 'webp']}
            loading="lazy"
          />
        </div>
        <Ticket spiel={naechstesSpiel} />
      </div>
    </div>
  </section>

  <Fanschal />

  <section class="section container" aria-labelledby="spieltag-titel">
    <div class="kopf">
      <div>
        <span class="eyebrow">1. Herren · {liga}</span>
        <h2 id="spieltag-titel" class="h2">Spieltag</h2>
      </div>
      <a href="/spielplan/" class="link-pfeil">Kompletter Spielplan <Arrow /></a>
    </div>
    <div class="spieltag">
      <div class="spieltag__links">
        <Spielkarte spiel={letztesSpiel} label="Letztes Spiel" />
        <div class="spieltag__form">
          <p class="mono">Formkurve, letzte {form.length} Spiele</p>
          <Form form={form} />
        </div>
      </div>
      <aside class="spieltag__tabelle" aria-labelledby="tabelle-titel">
        <div class="spieltag__stand">
          <h3 id="tabelle-titel" class="h3">Tabelle</h3>
          <p class="spieltag__platz">
            <span class="spieltag__platz-nr">{eigeneZeile.platz}.</span>
            <span class="mono">Platz · {eigeneZeile.punkte} Punkte</span>
          </p>
        </div>
        <Tabelle bis={6} />
        <a href="/spielplan/#tabelle" class="link-pfeil">Ganze Tabelle <Arrow /></a>
      </aside>
    </div>
  </section>

  <section class="section getoent bote" aria-labelledby="news-titel">
    <div class="container">
      <header class="bote__kopf">
        <p class="mono bote__zeile">
          <span>Vereinszeitung des {verein.kurzname}</span>
          <span>Ausgabe vom {datum(news[0].data.date)}</span>
        </p>
        <h2 id="news-titel" class="bote__titel">Der Mühlbach-Bote</h2>
        <p class="mono bote__zeile">
          <span>Kostenlos · Erscheint, wenn was passiert</span>
          <a href="/aktuelles/" class="link-pfeil">Alle Meldungen <Arrow /></a>
        </p>
      </header>
      <div class="bote__raster">
        {news.map((b, i) => <NewsCard beitrag={b} gross={i === 0} />)}
      </div>
    </div>
  </section>

  <section class="heimspiel nacht" aria-labelledby="heimspiel-titel">
    <div class="heimspiel__bild">
      <Picture src={heimspielBild} alt="" widths={[800, 1200, 1800, 2200]} sizes="100vw" formats={['avif', 'webp']} />
    </div>
    <div class="container heimspiel__text">
      <span class="eyebrow">Heimspiel</span>
      <h2 id="heimspiel-titel" class="heimspiel__titel">
        Sonntag,{' '}<br /><span class="akzent">15 Uhr.</span>
      </h2>
      <p class="lead">
        Bratwurst vom Grill, Kreide auf dem Rasen und 300 Leute an der Bande. Das Vereinsheim öffnet um 11 Uhr.
      </p>
      <a href="/verein/#anfahrt" class="btn btn--rand">Anfahrt zum Sportpark</a>
      <p class="heimspiel__preis">
        <span class="heimspiel__betrag">4 €</span>
        <span class="mono">Eintritt · Kinder &amp; Mitglieder frei</span>
      </p>
    </div>
  </section>

  <section class="section container album" aria-labelledby="teams-titel">
    <div class="kopf">
      <div>
        <span class="eyebrow">Saison {saison}</span>
        <h2 id="teams-titel" class="h2">Von U7 bis Ü32</h2>
      </div>
      <a href="/mannschaften/" class="link-pfeil">Alle {alleTeams.length} Mannschaften <Arrow /></a>
    </div>
    <div class="album__raster">
      {teams.map((t) => <TeamCard team={t} />)}
    </div>
  </section>

  <section class="bande" aria-labelledby="sponsoren-titel">
    <div class="container bande__kopf">
      <h2 id="sponsoren-titel" class="eyebrow">An der Bande: unsere Partner</h2>
      <a href="/sponsoren/" class="link-pfeil">Alle Sponsoren <Arrow /></a>
    </div>
    <ul class="bande__reihe">
      <li class="bande__tafel bande__tafel--haupt">
        <a href={hauptsponsor.url}>
          <span class="bande__rolle mono">Hauptsponsor</span>
          <Wortmarke sponsor={{ name: hauptsponsor.name, branche: hauptsponsor.branche, stil: 'block' }} />
        </a>
      </li>
      {
        premium.map((s) => (
          <li class="bande__tafel">
            <Wortmarke sponsor={s} />
          </li>
        ))
      }
    </ul>
    <div class="bande__rasen" aria-hidden="true"></div>
  </section>

  <MitmachenCta />
</BaseLayout>

<style>
  /* Titelseite */
  .hero {
    position: relative;
    overflow: hidden;
  }
  .hero__inner {
    position: relative;
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    padding-block: 1.25rem clamp(3.5rem, 2rem + 5vw, 6rem);
  }
  .hero__masthead {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 3px solid #fff;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .hero__titel {
    display: grid;
    gap: 0.06em;
    line-height: 0.8;
    letter-spacing: -0.01em;
  }
  /* Beide Zeilen laufen über die volle Breite, das Foto füllt die Lücke */
  .hero__zeile {
    display: flex;
    align-items: center;
    gap: 0.14em;
    font-size: clamp(2.3rem, 9vw, 8.2rem);
  }
  .hero__zeile--gross {
    font-size: clamp(3.3rem, 14.4vw, 13.1rem);
    margin-top: 0.04em;
    color: var(--ink);
  }
  .hero__foto {
    display: inline-block;
    flex: 1;
    min-width: 1.2em;
    height: 0.74em;
    border-radius: 999px;
    overflow: hidden;
    border: 0.035em solid var(--ink);
    background: var(--ink);
    transform: rotate(-4deg) translateY(-0.03em);
  }
  .hero__foto :global(picture),
  .hero__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 65%;
  }
  .hero__stempel {
    position: absolute;
    z-index: 2;
    bottom: -3.5rem;
    right: -1.5rem;
    display: grid;
    place-items: center;
    width: clamp(6.5rem, 5rem + 5vw, 10rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--gelb);
    color: var(--ink);
    border: 3px solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
    text-decoration: none;
    transition: transform 0.3s var(--ease);
  }
  .hero__stempel:hover {
    transform: scale(1.06) rotate(8deg);
  }
  .hero__stempel svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__stempel text {
    font-family: var(--font-mono-stack);
    font-weight: 700;
    font-size: 11.4px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    fill: currentColor;
  }
  .hero__stempel > span {
    font-size: 1.8rem;
    line-height: 1;
    color: var(--rot);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__stempel svg {
      animation: drehen 18s linear infinite;
    }
  }
  @keyframes drehen {
    to {
      transform: rotate(360deg);
    }
  }
  .hero__unten {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }
  .hero__text {
    display: grid;
    gap: 1.75rem;
  }
  .hero__bild {
    display: none;
  }
  .hero__text .lead {
    color: #fff;
    font-weight: 600;
  }
  .hero__aktionen {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .hero__zahlen {
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: start;
    gap: 0 2.25rem;
    margin: 0.5rem 0 0;
  }
  .hero__zahlen div {
    display: flex;
    flex-direction: column-reverse;
  }
  .hero__zahlen dt {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .hero__zahlen dd {
    margin: 0;
    font-family: var(--font-display-stack);
    font-weight: 900;
    font-size: var(--step-3);
    line-height: 0.9;
    color: var(--ink);
  }

  /* Anzeigetafel */
  .spieltag {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 1rem + 3vw, 4rem);
    align-items: start;
  }
  .spieltag__links {
    display: grid;
    gap: 1.75rem;
  }
  .spieltag__form {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.8rem;
    text-transform: uppercase;
  }
  .spieltag__tabelle {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .spieltag__tabelle > :global(.tabelle) {
    width: 100%;
  }
  .spieltag__stand {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
  }
  .spieltag__platz {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    text-transform: uppercase;
  }
  .spieltag__platz-nr {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--rot);
    color: #fff;
    font-family: var(--font-display-stack);
    font-weight: 900;
    font-size: 1.7rem;
  }

  /* Vereinszeitung */
  .bote__kopf {
    display: grid;
    gap: 0.75rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    text-align: center;
  }
  .bote__zeile {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1rem;
    padding-block: 0.5rem;
    border-block: 1px solid var(--ink);
    font-size: 0.75rem;
    text-transform: uppercase;
  }
  .bote__titel {
    font-size: clamp(3rem, 1rem + 9vw, 9rem);
    line-height: 0.85;
    letter-spacing: -0.01em;
  }
  .bote__raster {
    --spalt: clamp(1.5rem, 1rem + 2vw, 3rem);
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    grid-template-rows: auto auto;
    row-gap: 2rem;
  }
  .bote__raster > :global(:first-child) {
    grid-row: span 2;
    padding-right: var(--spalt);
  }
  .bote__raster > :global(:not(:first-child)) {
    padding-left: var(--spalt);
    border-left: 1px solid var(--ink);
  }
  .bote__raster > :global(:nth-child(3)) {
    padding-top: 2rem;
    border-top: 1px solid var(--ink);
  }

  /* Heimspiel-Plakat */
  .heimspiel {
    position: relative;
    display: grid;
    min-height: 44rem;
    isolation: isolate;
    overflow: hidden;
  }
  .heimspiel__bild {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--nacht);
  }
  .heimspiel__bild :global(picture),
  .heimspiel__bild :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .heimspiel__bild :global(img) {
    filter: grayscale(1) contrast(1.2) brightness(0.55);
  }
  .heimspiel__bild::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(rgb(0 0 0 / 0.55) 1.4px, transparent 1.9px) 0 0 / 7px 7px,
      linear-gradient(90deg, rgb(20 18 16 / 0.9) 0%, rgb(20 18 16 / 0.4) 70%, transparent 100%);
  }
  .heimspiel__text {
    position: relative;
    display: grid;
    gap: 1.5rem;
    align-content: center;
    justify-items: start;
    padding-block: var(--section);
  }
  .heimspiel__titel {
    font-size: clamp(4rem, 1rem + 13vw, 14rem);
    line-height: 0.8;
  }
  .heimspiel__text .lead {
    color: var(--on-nacht);
    max-width: 28em;
  }
  .heimspiel__preis {
    position: absolute;
    right: var(--gutter);
    bottom: var(--section);
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.3rem;
    width: clamp(9rem, 7rem + 6vw, 13rem);
    aspect-ratio: 1;
    padding: 1.5rem;
    border-radius: 50%;
    background: var(--gelb);
    color: var(--ink);
    border: 3px solid var(--ink);
    box-shadow: 6px 6px 0 var(--rot);
    text-align: center;
    transform: rotate(-12deg);
  }
  .heimspiel__betrag {
    font-family: var(--font-display-stack);
    font-weight: 900;
    font-size: clamp(3rem, 2.2rem + 3vw, 5rem);
    line-height: 0.85;
  }
  .heimspiel__preis .mono {
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
  }

  /* Sammelalbum */
  .album__raster {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 1rem + 2vw, 2.75rem);
  }

  /* Bandenwerbung */
  .bande {
    padding-top: calc(var(--section) * 0.6);
    background: var(--kreide-2);
    border-top: 3px solid var(--ink);
  }
  .bande__kopf {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }
  .bande__reihe {
    display: grid;
    grid-template-columns: 1.6fr repeat(4, 1fr);
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 4px;
    background: var(--ink);
  }
  .bande__tafel {
    display: grid;
    place-items: center;
    min-height: 6.5rem;
    padding: 1rem 1.25rem;
    background: #fff;
    color: var(--ink);
    text-align: center;
  }
  .bande__tafel:nth-child(3) {
    background: var(--ink);
    color: var(--gelb);
  }
  .bande__tafel:nth-child(4) {
    background: var(--gelb);
  }
  .bande__tafel:nth-child(5) {
    background: var(--nacht-2);
    color: #fff;
  }
  .bande__tafel--haupt {
    background: var(--rot);
    color: #fff;
  }
  .bande__tafel--haupt a {
    display: grid;
    gap: 0.3rem;
    text-decoration: none;
  }
  .bande__tafel--haupt a:hover :global(.marke) {
    text-decoration: underline;
    text-decoration-thickness: 3px;
  }
  .bande__rolle {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .bande__rasen {
    height: clamp(2.5rem, 2rem + 2vw, 4rem);
    background:
      linear-gradient(#fff, #fff) 0 0.9rem / 100% 3px no-repeat,
      repeating-linear-gradient(90deg, var(--rasen) 0 4rem, #1a6c35 4rem 8rem);
  }

  @media (max-width: 64rem) {
    .spieltag {
      grid-template-columns: 1fr;
    }
    .album__raster {
      grid-template-columns: repeat(2, 1fr);
    }
    .bande__reihe {
      grid-template-columns: repeat(2, 1fr);
    }
    .bande__tafel--haupt {
      grid-column: 1 / -1;
    }
    .bote__raster {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--spalt);
    }
    .bote__raster > :global(:first-child) {
      grid-column: 1 / -1;
      grid-row: auto;
      padding-right: 0;
    }
    .bote__raster > :global(:not(:first-child)) {
      padding-left: 0;
      border-left: 0;
    }
    .bote__raster > :global(:nth-child(3)) {
      padding-top: 0;
      border-top: 0;
    }
  }
  @media (max-width: 60rem) {
    .hero__unten {
      grid-template-columns: 1fr;
    }
    .heimspiel__preis {
      position: static;
      margin-top: 1rem;
    }
  }
  @media (max-width: 40rem) {
    .hero__masthead-ort {
      display: none;
    }
    .hero__zahlen {
      grid-template-columns: repeat(2, auto);
      gap: 1rem 2.25rem;
    }
    .hero__stempel {
      display: none;
    }
    .bote__raster,
    .album__raster {
      grid-template-columns: 1fr;
    }
  }
</style>
